{
  "name": "mindsync-root",
  "version": "1.0.0",
  "description": "MindSync - AI Powered Wellness Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "install:client": "npm install --prefix client",
    "install:server": "npm install --prefix server",
    "install:all": "npm install && npm run install:client && npm run install:server",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm start --prefix server",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm run build --prefix client",
    "build:server": "echo 'No build step for server'",
    "build": "npm install --include=dev --prefix client && npm run build:client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "groq-sdk": "^0.3.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "winston": "^3.12.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
